<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same exclusions as backup_rules.xml, for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="books" />
        <exclude domain="file" path="library-index.json" />
        <exclude domain="file" path="library-kinds.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="books" />
        <exclude domain="file" path="library-index.json" />
        <exclude domain="file" path="library-kinds.json" />
    </device-transfer>
</data-extraction-rules>
